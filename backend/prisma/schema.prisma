generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id              Int      @id @default(autoincrement())
  nom             String
  prenom          String
  email           String   @unique
  motDePasseHash  String
  role            String
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())

  candidatures        Candidature[] @relation("CandidatCandidature")
  stagiairesEncadres  Stagiaire[]   @relation("TuteurStagiaire")
  evaluationsRedigees Evaluation[]  @relation("TuteurEvaluation")
  evaluationsValidees Evaluation[]  @relation("ResponsableRHEvaluation")
}

model Candidature {
  id                  Int         @id @default(autoincrement())
  dateDepot           DateTime    @default(now())
  statut              String      @default("DEPOSEE")
  typeStage           String
  sujetStage          String?
  dateDebutSouhaitee  DateTime
  dateFinSouhaitee    DateTime

  candidat            Utilisateur @relation("CandidatCandidature", fields: [candidatId], references: [id])
  candidatId          Int

  piecesJointes       PieceJointe[]
  stagiaire           Stagiaire?
}

model PieceJointe {
  id             Int         @id @default(autoincrement())
  type           String
  cheminFichier  String
  dateAjout      DateTime    @default(now())

  candidature    Candidature @relation(fields: [candidatureId], references: [id])
  candidatureId  Int
}

model Departement {
  id          Int    @id @default(autoincrement())
  nom         String @unique
  description String?

  stagiaires  Stagiaire[]
}

model Stagiaire {
  id             Int         @id @default(autoincrement())
  dateDebut      DateTime
  dateFin        DateTime
  statut         String      @default("A_VENIR")

  candidature    Candidature @relation(fields: [candidatureId], references: [id])
  candidatureId  Int         @unique

  departement    Departement @relation(fields: [departementId], references: [id])
  departementId  Int

  tuteur         Utilisateur @relation("TuteurStagiaire", fields: [tuteurId], references: [id])
  tuteurId       Int

  presences      Presence[]
  documents      DocumentGenere[]
  evaluations    Evaluation[]
}

model Presence {
  id             Int       @id @default(autoincrement())
  date           DateTime
  statut         String
  heureArrivee   String?
  heureDepart    String?

  stagiaire      Stagiaire @relation(fields: [stagiaireId], references: [id])
  stagiaireId    Int

  @@unique([stagiaireId, date])
}

model DocumentGenere {
  id              Int       @id @default(autoincrement())
  type            String
  cheminFichier   String
  dateGeneration  DateTime  @default(now())

  stagiaire       Stagiaire @relation(fields: [stagiaireId], references: [id])
  stagiaireId     Int
}

model Evaluation {
  id                  Int         @id @default(autoincrement())
  dateEvaluation      DateTime    @default(now())
  note                Float?
  commentaire         String?
  statutValidation    String      @default("EN_ATTENTE")
  dateValidation      DateTime?

  stagiaire           Stagiaire   @relation(fields: [stagiaireId], references: [id])
  stagiaireId         Int

  tuteur              Utilisateur @relation("TuteurEvaluation", fields: [tuteurId], references: [id])
  tuteurId            Int

  responsableRH       Utilisateur? @relation("ResponsableRHEvaluation", fields: [responsableRHId], references: [id])
  responsableRHId     Int?
}
